{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Valendata",
  "logo": {
    "dark": "/logo/light.png",
    "light": "/logo/dark.png",
    "href": "https://valendata.com"
  },
  "favicon": "/favicon.ico",
  "modeToggle": {
    "default": "light",
    "isHidden": false
  },
  "colors": {
    "primary": "#16a34a",
    "light": "#16a34a",
    "dark": "#2BDD66",
    "background": {
      "light": "#FFFFFF",
      "dark": "#0B0F17"
    }
  },
  "topbarLinks": [
    {
      "name": "Website",
      "url": "https://valendata.com"
    },
    {
      "name": "Community",
      "url": "https://app.valendata.com/community"
    }
  ],
  "topbarCta": {
    "name": "Launch Console",
    "url": "https://app.valendata.com"
  },
  "navigation": [
    {
      "group": "Get Started",
      "pages": [
        "introduction",
        "quickstart"
      ]
    },
    {
      "group": "Core Concepts",
      "pages": [
        "core-concepts/skills",
        "core-concepts/workflows",
        "core-concepts/schedules",
        "core-concepts/remote-browsers",
        "core-concepts/inbox",
        "core-concepts/credits-and-billing"
      ]
    },
    {
      "group": "API Reference",
      "pages": [
        "api-reference/introduction",
        "api-reference/authentication",
        {
          "group": "Skills API",
          "pages": [
            "api-reference/skills/run",
            "api-reference/skills/list",
            "api-reference/skills/create"
          ]
        },
        {
          "group": "Workflows API",
          "pages": [
            "api-reference/workflows/execute"
          ]
        },
        {
          "group": "Sessions API",
          "pages": [
            "api-reference/sessions/status",
            "api-reference/sessions/recordings"
          ]
        }
      ]
    },
    {
      "group": "Integrations & Connectors",
      "pages": [
        "integrations/mcp",
        "integrations/webhooks",
        "integrations/n8n"
      ]
    }
  ],
  "footerSocials": {
    "x": "https://twitter.com/valendata",
    "github": "https://github.com/valendata-software",
    "discord": "https://discord.gg/valendata"
  },
  "feedback": {
    "suggestEdit": true,
    "raiseIssue": true
  }
}
