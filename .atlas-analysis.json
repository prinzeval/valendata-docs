  "keyFeatures": [
    "AI-driven browser automation with real Chromium — no selectors, no brittle scripts",
    "Skills: named, reusable automation tasks deployable as versioned API endpoints",
    "Workflows: chain skills with HTTP steps, transforms, and cron scheduling",
    "No-code recorder: walk through a workflow once and auto-generate a deployable skill",
    "Chrome Profiles: persist browser sessions so scheduled runs stay logged in",
    "Native CAPTCHA solving and 2FA/TOTP handling — no third-party services",
    "47 global regions with proxy rotation and real Chromium sessions",
    "Full run observability: every step recorded, replayable frame-by-frame",
    "Strict JSON schema enforcement on every run output",
    "Marketplace of public, cloneable skills",
    "Workspaces for team collaboration and role management",
    "Credit-based pay-as-you-go billing (credits never expire)"
  ],
  "publicApiSurface": [
    "POST api.valendata.com/v1/run — execute a skill by ID",
    "GET api.valendata.com/v1/skills — list skills in a workspace",
    "GET api.valendata.com/v1/skills/:id — get skill details",
    "POST api.valendata.com/v1/workflows/run — trigger a workflow",
    "GET api.valendata.com/v1/workflows — list workflows",
    "GET api.valendata.com/v1/runs/:id — fetch run result and replay data",
    "GET api.valendata.com/v1/runs — list run history",
