{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Valendata",
  "theme": "maple",
  "favicon": "https://media.brand.dev/9368dd59-b624-47ee-837e-7118bdeeca4e.png",
  "colors": {
    "primary": "#12b981",
    "light": "#12b981",
    "dark": "#12b981"
  },
  "fonts": {
    "heading": {
      "family": "Plus Jakarta Sans"
    },
    "body": {
      "family": "Plus Jakarta Sans"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Website",
      "href": "https://valendata.com"
    },
    "links": [
      {
        "href": "mailto:info@valendata.com",
        "label": "Support"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "credits-and-billing"
            ],
            "icon": "rocket"
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/skills",
              "concepts/workflows",
              "concepts/chrome-profiles",
              "concepts/workspaces",
              "concepts/keeping-skills-working"
            ],
            "icon": "lightbulb"
          },
          {
            "group": "Guides",
            "pages": [
              "guides/web-to-api",
              "guides/recording-a-skill",
              "guides/skills-that-need-a-login",
              "guides/scheduling-skills",
              "guides/using-the-marketplace",
              "guides/exporting-data"
            ],
            "icon": "book-open"
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/overview",
              "integrations/connect-ai-assistants",
              "integrations/mcp"
            ],
            "icon": "plug"
          },
          {
            "group": "Account & Security",
            "pages": [
              "account/two-factor-authentication",
              "account/api-keys",
              "account/data-export"
            ],
            "icon": "shield"
          }
        ]
      },
      {
