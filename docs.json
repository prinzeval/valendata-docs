  "footer": {
    "socials": {
      "website": "https://valendata.com"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "logo": {
    "light": "/images/logo-light.png",
    "dark": "/images/logo-dark.png",
    "href": "https://valendata.com/"
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  }
}