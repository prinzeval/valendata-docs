{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Valendata",
  "theme": "maple",
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#12b981",
    "light": "#12b981",
    "dark": "#12b981"
  },
  "fonts": {
    "heading": {
      "family": "Plus Jakarta Sans"
    },
    "body": {
      "family": "Plus Jakarta Sans"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Website",
      "href": "https://valendata.com"
    },
    "links": [
      {
        "href": "mailto:info@valendata.com",
        "label": "Support"
      }
    ]
  },
