{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Valendata",
  "colors": {
    "primary": "#16a34a",
    "light": "#16a34a",
    "dark": "#2BDD66"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": [
          "introduction",
          "quickstart"
        ]
      },
      {
        "group": "Core Concepts",
        "pages": [
          "core-concepts/skills",
          "core-concepts/workflows",
          "core-concepts/schedules",
          "core-concepts/remote-browsers",
          "core-concepts/inbox",
          "core-concepts/credits-and-billing"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api-reference/introduction",
          "api-reference/authentication",
          {
            "group": "Skills API",
            "pages": [
              "api-reference/skills/run",
              "api-reference/skills/list",
              "api-reference/skills/create"
            ]
          },
          {
            "group": "Workflows API",
            "pages": [
              "api-reference/workflows/execute"
            ]
          },
          {
            "group": "Sessions API",
            "pages": [
              "api-reference/sessions/status",
              "api-reference/sessions/recordings"
            ]
          }
        ]
      },
      {
        "group": "Integrations & Connectors",
        "pages": [
          "integrations/mcp",
          "integrations/webhooks",
          "integrations/n8n"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/dark.png",
    "dark": "/logo/light.png",
    "href": "https://valendata.com"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B0F17"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://valendata.com"
      },
      {
        "label": "Community",
        "href": "https://app.valendata.com/community"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/Valendata_",
      "github": "https://github.com/valendata-software",
      "discord": "https://discord.gg/valendata"
    }
  }
}