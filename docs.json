        "groups": [
          {
            "group": "Overview",
            "icon": "book-open",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Skills",
            "icon": "sparkles",
            "pages": [
              "api-reference/skills/contract",
              "api-reference/skills/health",
              "api-reference/skills/run-by-slug",
              "api-reference/skills/run-by-id",
              "api-reference/skills/list",
              "api-reference/skills/get"
            ]
          },
          {
            "group": "Skill creation",
            "icon": "wand-magic-sparkles",
            "pages": [
              "api-reference/skills/create",
              "api-reference/skill-creations/get"
            ]
          },
          {
            "group": "Skill improvement",
            "icon": "wand-magic",
            "pages": [
              "api-reference/skills/improve",
              "api-reference/skill-improvements/get",
              "api-reference/skill-improvements/list"
            ]
          },
          {
            "group": "Versions",
            "icon": "code-branch",
            "pages": [
              "api-reference/versions/list",
              "api-reference/versions/diff",
              "api-reference/versions/restore",
              "api-reference/versions/pin"
            ]
          },
          {
            "group": "Workflows",
            "icon": "diagram-project",
            "pages": [
              "api-reference/workflows/list",
              "api-reference/workflows/run"
            ]
          },
          {
            "group": "Runs",
            "icon": "clock-rotate-left",
            "pages": [
              "api-reference/runs/start",
              "api-reference/runs/get-skill-run",
              "api-reference/runs/list",
              "api-reference/runs/get"
